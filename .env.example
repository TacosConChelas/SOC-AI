# Copy to .env — never commit real secrets.
# A4 migrates credentials to /run/secrets/ mounted files (no secrets in environment: blocks).

# ── Redis ──────────────────────────────────────────────────────────────────
SOC_REDIS_URL=redis://redis:6379       # compose sets this per-service; override for local dev
REDIS_USER=                            # A4: ACL user for worker
REDIS_PASSWORD=                        # A4: ACL password for worker

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
POSTGRES_DSN=postgresql://soc:changeme@postgres:5432/soc

# ── OpenSearch (Wazuh Indexer) ────────────────────────────────────────────
# OPENSEARCH_URL is injected per-service in compose (https://wazuh.indexer:9200)
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=changeme           # same as WAZUH_INDEXER_PASSWORD

# ── Wazuh ─────────────────────────────────────────────────────────────────
WAZUH_INDEXER_PASSWORD=changeme
# CA cert PEM content — run after generating Wazuh certs:
#   export WAZUH_INDEXER_CA_CERT=$(cat services/wazuh/certs/root-ca.pem)
# or paste the cert content here (multi-line works in .env with quotes)
WAZUH_INDEXER_CA_CERT=
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=changeme
# WAZUH_API_USER/PASSWORD: consumed by wazuh.manager/wazuh.dashboard's own API auth only —
# the collector reads alerts from OpenSearch directly (D-01), not this API.
# WAZUH_CA_BUNDLE=/run/secrets/wazuh-root-ca  # A4: mounted cert path

# ── Ollama ────────────────────────────────────────────────────────────────
# OLLAMA_URL is injected per-service in compose (http://ollama:11434)
# soc-ai-triage (Foundation-Sec-8B-Instruct fine-tune, ADR-0008) is the correct fallback
# default docker-compose.yml already uses (${OLLAMA_MODEL:-soc-ai-triage}) — never point this
# at an unrelated base model.
OLLAMA_MODEL=soc-ai-triage

# ── Notifications ─────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_CHANNEL=#soc-alerts
SLACK_SYSTEM_CHANNEL=#soc-system
SLACK_API_URL=https://slack.com/api

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=0
TELEGRAM_SYSTEM_CHAT_ID=0
TELEGRAM_API_BASE=https://api.telegram.org

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme


# ── Allowlist (enrichment) ────────────────────────────────────────────────
SOC_SOURCE_ALLOWLIST=192.168.0.0/16,10.0.0.0/8

# ── Notify guardrails ─────────────────────────────────────────────────────
# PD-005 (ADR-0004 Enmienda 2026-08, D-16/D-20) — level 0 of the notify tree: events
# older than this never notify (they are still ingested/classified/grouped/persisted).
# Starting value 2h, sized for the CloudTrail backlog-on-startup scenario; open to
# calibration with real session data.
SOC_NOTIFY_MAX_EVENT_AGE_S=7200
