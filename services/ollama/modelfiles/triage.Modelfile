# After ollama service starts: ollama create soc-ai-triage -f /modelfiles/triage.Modelfile
#
# No SYSTEM here on purpose: the worker sends core/orchestrator/prompts/system.txt on every
# /api/chat request (single source, SHA256-pinned). A copy here could only drift.
#
# TEMPLATE/stop mirror chat_template.jinja of fdtn-ai/Foundation-Sec-1.1-8B-Instruct
# (revision 243b27655e01c87cc04fdb88632be7cd9e55ac1f) — NOT the Llama-3.1 header format.
FROM /data/models/foundation-sec-8b-triage-q4.gguf

TEMPLATE """{{ if .System }}<|system|>
{{ .System }}
{{ end }}{{ if .Prompt }}<|user|>
{{ .Prompt }}
{{ end }}<|assistant|>
{{ .Response }}<|end_of_text|>"""

PARAMETER stop "<|end_of_text|>"
PARAMETER stop "<|user|>"
PARAMETER stop "<|system|>"
# num_ctx is NOT set here: the worker sends it on every request (prompts.NUM_CTX) so the
# prompt-only baseline tag gets it too.
PARAMETER temperature 0.1
PARAMETER top_p 0.9
